{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "@cloudflare/workers-types"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app/ui/**/*.tsx",
    "main.tsx",
    "lib/client.ts",
    "lib/routes.ts",
    "lib/types.ts",
    "lib/calc.ts",
    "api/**/*.ts",
    "vite.config.ts",
    "cloudflare-env.d.ts"
  ]
}